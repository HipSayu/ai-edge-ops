# Copy to .env and adjust. Values here are the local defaults.
# Nested groups use "__": DB__URL -> settings.db.url
ENVIRONMENT=local

CORS_ORIGINS=["http://localhost:5173"]
OFFLINE_THRESHOLD_SECONDS=90
LATENCY_SLO_MS=80

# Generate a random value with at least 32 characters for production.
JWT_SECRET=change-this-in-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# edge transport: memory | mqtt
EDGE_TRANSPORT=memory
# browser realtime fan-out: memory (single replica) | redis (multi-replica)
REALTIME_TRANSPORT=memory

# --- database (settings.db) ---
# Host ports match deploy/.env.infra (5xxxx range). Only relevant when running
# the server bare-metal against `docker compose -f compose.infra.yml up`.
DB__URL=postgresql+asyncpg://ppe:ppe@localhost:55432/ai_edge_ops
DB__POOL_SIZE=5
DB__ECHO=false

# --- mqtt (settings.mqtt, used when EDGE_TRANSPORT=mqtt) ---
# Dev: plain MQTT on the data-stack host port. Prod: 8883 + TLS.
MQTT__HOST=localhost
MQTT__PORT=51883
MQTT__USERNAME=
MQTT__PASSWORD=
MQTT__TLS=true
MQTT__TLS_CA_FILE=/run/secrets/mqtt/ca.crt
MQTT__TLS_CERT_FILE=/run/secrets/mqtt/client.crt
MQTT__TLS_KEY_FILE=/run/secrets/mqtt/client.key
MQTT__QOS=1

# --- redis (settings.redis) ---
REDIS__URL=redis://localhost:56379/0

# --- WebRTC streaming: edge -> MediaMTX -> frontend, see app/modules/streaming ---
MEDIAMTX_WHIP_URL=http://localhost:58889
MEDIAMTX_WHEP_URL=http://localhost:58889
STREAM_TOKEN_SECONDS=30
