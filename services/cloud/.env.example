# Copy to .env. Read only by the cloud service (prefix CLOUD_). docker-compose.yml sets paths, database URL and MQTT credentials.
CLOUD_JWT_TTL_MIN=720
CLOUD_GRID_SIZE=9
CLOUD_JWT_PRIVATE_KEY_PATH=volume/keys/safety-private.pem
# docker-compose.yml sets the broker and Redis below. For a cloud run on the host, uncomment and fill in:
# CLOUD_MQTT_HOST=localhost
# CLOUD_MQTT_PORT=8883
# CLOUD_MQTT_USERNAME=cloud
# CLOUD_MQTT_PASSWORD=
# CLOUD_MQTT_TLS_CA=volume/mosquitto/certs/ca.crt
# CLOUD_REDIS_URL=redis://:<REDIS_PASSWORD>@localhost:6379/0

# The chat assistant is an agent in Dunly (run tools/setup_dunly.py to create it and its API key).
# From inside docker compose, a Dunly running on this machine is reached as host.docker.internal.
# CLOUD_DUNLY_URL=http://host.docker.internal:8790
# CLOUD_DUNLY_API_KEY=sk-dl-...      # scopes sessions:read, sessions:write, sessions:forward
# CLOUD_DUNLY_AGENT=ppe-assistant
