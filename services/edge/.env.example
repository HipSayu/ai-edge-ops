# Copy to services/edge/.env. One file per edge node.
EDGE_NODE_ID=node-1
EDGE_CAMERAS=[{"id": 1, "video": "volume/data/video"}]

# The broker (TLS). The user name is the node id: the broker lets a node publish only under ppe/<node id>/.
# Create the user on the broker: mosquitto_passwd /work/passwd <node id>  (see README). ca.crt comes from
# docs/mosquitto/make-certs.sh; the broker's address must be one of the names that script was given.
EDGE_MQTT_HOST=localhost
EDGE_MQTT_PORT=8883
EDGE_MQTT_USERNAME=node-1
EDGE_MQTT_PASSWORD=
EDGE_MQTT_TLS_CA=volume/mosquitto/certs/ca.crt

# Events not yet acknowledged by the broker wait in this file (keep it on a disk that survives a restart).
# EDGE_OUTBOX_PATH=data/outbox.db
# EDGE_OUTBOX_MAX_EVENTS=500
