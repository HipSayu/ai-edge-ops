# ── app env — control plane (compose.yml dev / compose.app.yml prod) ───────
# Copy to .env.app. Always loaded alongside .env.infra:
#   dev  : COMPOSE_ENV_FILES=.env.infra,.env.app docker compose up
#   prod : COMPOSE_ENV_FILES=.env.infra,.env.app \
#            docker compose -f compose.infra.yml -f compose.app.yml up -d

# server image — dev builds locally from this tag; prod pulls IMAGE_PREFIX/-server
SERVER_IMAGE=ai-edge-ops/server:dev
SERVER_HTTP_PORT=8000

SERVER_ENVIRONMENT=local                    # prod: production
SERVER_CORS_ORIGINS=["*"]                   # prod: ["https://YOUR_DOMAIN"]
SERVER_EDGE_TRANSPORT=mqtt
SERVER_REALTIME_TRANSPORT=redis
SERVER_EVIDENCE_DIR=/var/lib/ai-edge-ops/evidence

SERVER_DB_URL=postgresql+asyncpg://ppe:ppe@db:5432/ai_edge_ops
SERVER_REDIS_URL=redis://redis:6379/0
SERVER_MQTT_HOST=mqtt
SERVER_MQTT_PORT=1883                       # prod: 8883
SERVER_MQTT_TLS=false                       # prod: true
SERVER_MEDIAMTX_WHIP_URL=http://mediamtx:8889
SERVER_MEDIAMTX_WHEP_URL=http://localhost:58889   # prod: https://YOUR_DOMAIN

JWT_SECRET=change-this-in-production        # prod: real 32+ char secret
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# ── prod only (compose.app.yml) ───────────────────────────────────────────
DOMAIN=ops.example.com
IMAGE_PREFIX=ghcr.io/hopquangdo/ai-edge-ops
IMAGE_TAG=latest
MQTT_USERNAME=                              # broker creds the server logs in with
MQTT_PASSWORD=

# ── model registry — server reads the model catalog from GHCR (S2+) ───────
# The model package is public (built + published by a separate pipeline), so the
# catalog is read anonymously via ghcr.io/v2. TOKEN only for private / rate limit.
MODEL_REGISTRY__OWNER=hopquangdo
MODEL_REGISTRY__PACKAGE=ai-edge-ops-model
MODEL_REGISTRY__TOKEN=
