# ── infra env — backing services (compose.infra.yml) ───────────────────────
# Copy to .env.infra. Used by EVERY stack (dev / prod / VPS).
#   COMPOSE_ENV_FILES=.env.infra docker compose -f compose.infra.yml up -d
# Compose files have no literals and no fallbacks — every key must be set.

# container / volume / network prefix — unique per box
COMPOSE_PROJECT_NAME=ai-edge-ops

# Postgres
POSTGRES_USER=ppe
POSTGRES_PASSWORD=ppe                       # prod: long random
POSTGRES_DB=ai_edge_ops
DB_PORT=55432

# Redis
REDIS_PASSWORD=                             # empty = no auth (dev). prod: set it
REDIS_PORT=56379

# EMQX / MQTT broker
EMQX_DASHBOARD_PASSWORD=public              # prod: long random
MQTT_PORT=51883                             # plain MQTT host port
MQTT_TLS_PORT=58883                         # MQTT-over-TLS host port
MQTT_DASHBOARD_PORT=58083

# MediaMTX (WebRTC SFU)
MEDIAMTX_HTTP_PORT=58889
MEDIAMTX_ICE_PORT=58189
# host browsers/edge reach MediaMTX on — goes into ICE candidates.
# dev: this box's LAN IP. prod/VPS: the public host.
MEDIAMTX_WEBRTC_HOST=localhost
# "http" -> the server verifies each publish/view.
# infra-only box with no server: MEDIAMTX_AUTH_METHOD=internal
MEDIAMTX_AUTH_METHOD=http
MEDIAMTX_AUTH_URL=http://server:8000/api/v1/streaming/auth
