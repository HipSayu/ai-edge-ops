# ── edge env — agent + inference sidecar ──────────────────────────────────
# Copy to .env.edge.
#   dev demo : COMPOSE_ENV_FILES=.env.infra,.env.app,.env.edge \
#                docker compose --profile edge up
#   device   : rename compose.edge.yml -> compose.yml, then
#              COMPOSE_ENV_FILES=.env.edge docker compose up -d

# device (also the container/volume prefix on a standalone box)
COMPOSE_PROJECT_NAME=ai-edge-ops
DEVICE_ID=edge-dev-1
EDGE_AGENT_IMAGE=ai-edge-ops/edge-agent:dev
AGENT_API_PORT=9100

AGENT_TRANSPORT=mqtt
AGENT_MQTT_HOST=mqtt                        # device: the broker's host / IP
AGENT_MQTT_PORT=1883                        # device: 58883 for TLS
AGENT_MQTT_TLS=false                        # device: true
AGENT_MQTT_USERNAME=
AGENT_MQTT_PASSWORD=
AGENT_SERVER_BASE_URL=http://server:8000/api/v1   # device: https://YOUR_DOMAIN/api/v1
AGENT_CAMERAS=[{"id":"bay-1","source":"0","zone":"loading-bay","enabled":true,"fps_limit":10}]

# inference sidecar — the agent rewrites INFERENCE_IMAGE in this file on deploy
INFERENCE_IMAGE=ai-edge-ops/inference:dev
INFERENCE_RUNTIME=dummy
