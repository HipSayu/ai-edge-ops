# ── edge env — agent + inference sidecar ──────────────────────────────────
# Copy to .env.edge.
#   dev demo : COMPOSE_ENV_FILES=.env.infra,.env.app,.env.edge \
#                docker compose --profile edge up
#   device   : rename compose.edge.yml -> compose.yml, then
#              COMPOSE_ENV_FILES=.env.edge docker compose up -d

# device (also the container/volume prefix on a standalone box)
COMPOSE_PROJECT_NAME=ai-edge-ops
DEVICE_ID=edge-dev-1
EDGE_AGENT_IMAGE=ai-edge-ops/edge-agent:dev
AGENT_API_PORT=9100

AGENT_TRANSPORT=mqtt
AGENT_MQTT_HOST=mqtt                        # device: the broker's host / IP
AGENT_MQTT_PORT=1883                        # device: 58883 for TLS
AGENT_MQTT_TLS=false                        # device: true
AGENT_MQTT_USERNAME=
AGENT_MQTT_PASSWORD=
AGENT_SERVER_BASE_URL=http://server:8000/api/v1   # device: https://YOUR_DOMAIN/api/v1
AGENT_CAMERAS=[{"id":"bay-1","source":"0","zone":"loading-bay","enabled":true,"fps_limit":10}]

# inference sidecar — one multi-arch model image (amd64 + arm64), runtime
# auto-detects CUDA/MPS/CPU. The agent rewrites INFERENCE_IMAGE here on deploy.
# The GHCR model package is PUBLIC (MVP) → no registry login on the device.
# device: ghcr.io/hopquangdo/ai-edge-ops-model:<version>  (RUNTIME defaults to
# auto inside a real model image; keep dummy for the weightless dev build)
INFERENCE_IMAGE=ai-edge-ops/inference:dev
INFERENCE_RUNTIME=dummy

# ── live streaming (edge camera -> MediaMTX -> dashboard) ────────────────────
AGENT_STREAMING_ENABLED=false               # true to publish the camera feed
AGENT_STREAMING_ENCODER=auto                # auto | libx264 | h264_nvenc | h264_vaapi | v4l2m2m
AGENT_STREAMING_BITRATE_KBPS=1500

# ffmpeg's WHIP muxer can't finish an ICE handshake with MediaMTX, so publish
# over RTMP. Point at the MediaMTX RTMP ingest (compose.infra exposes :1935).
VR_RTMP_BASE=rtmp://YOUR_HOST:1935

# On Docker Desktop / Windows the inference container can't open a webcam; when
# ffmpeg owns the device, keep the pipeline ticking on a placeholder frame.
VR_DISABLE_CAPTURE=                          # set to 1 to enable
VR_DSHOW_VIDEO=Integrated Camera             # Windows: `ffmpeg -f dshow -list_devices true -i dummy`

# Capture / encode tuning — lower = less CPU + latency, more dropped frames.
VR_CAPTURE_SIZE=640x480
VR_CAPTURE_FPS=30
VR_CAPTURE_RTBUFSIZE=16M
VR_CAPTURE_QUEUE=8
VR_STREAM_FPS=15
VR_WHIP_GOP=30
VR_RTMP_GOP=15
