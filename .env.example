# Copy to .env. Read by docker compose only (substitution + published ports); services get no variables from here.
# The cloud's own settings live in services/cloud/.env (copy its .env.example).
POSTGRES_PASSWORD=change-me-db-password
DB_PORT=5432
# MQTT broker (TLS): the cloud's own login. Every edge node has its own (user name = node id), see docs/mosquitto/acl.
MQTT_CLOUD_USERNAME=cloud
MQTT_CLOUD_PASSWORD=change-me-mqtt-password
# MQTT_PORT=8883

# Fake edges (docker compose --profile sim): password of their broker users, mean seconds between events of a node
# FAKE_EDGE_PASSWORD=change-me-fake-edge-password
# FAKE_EDGE_INTERVAL=10

# Redis Stack: chat sessions, agent memory, edge event ids already taken
REDIS_PASSWORD=change-me-redis-password
# REDIS_PORT=6379
API_PORT=8200
WEB_PORT=8080
