# Copy to app/.env — docker compose reads it automatically for the dev stack.
# Everything here has a working default in the compose files; override only if
# you need to.

# --- shared infra credentials ---
# POSTGRES_USER=ppe
# POSTGRES_PASSWORD=ppe
# POSTGRES_DB=ai_edge_ops
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# --- backing-service host ports (docker-compose.data.yml) ---
# Defaults sit in the 5xxxx range to avoid clashing with a system Postgres/Redis
# or another project. Set these back to the standard ports if you prefer.
# DB_PORT=55432
# REDIS_PORT=56379
# MQTT_PORT=51883
# MQTT_DASHBOARD_PORT=58083
# MINIO_PORT=59000
# MINIO_CONSOLE_PORT=59001
# MEDIAMTX_HTTP_PORT=58889
# MEDIAMTX_ICE_PORT=58189

# --- nginx reverse-proxy overlay (nginx/compose.yml) ---
# NGINX_PORT=58080

# --- WebRTC video for other machines on the LAN ---
# Your machine's LAN IP; MediaMTX advertises it in ICE candidates and the
# server hands it to browsers as the WHEP host.
# LAN_IP=192.168.1.50

# --- edge-agent demo (docker compose --profile edge up) ---
# DEVICE_ID=edge-dev-1
