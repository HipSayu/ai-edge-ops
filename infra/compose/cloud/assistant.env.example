# Copy to assistant.env (gitignored). Redis / Cloud API / Qdrant URLs are set in docker-compose.yml.
ASSISTANT_LOG_JSON=true
ASSISTANT_LLM_MODEL=openai:gpt-5.4-mini
# auto (the model decides when and how much to think) / low / medium / high, or off
ASSISTANT_LLM_REASONING_EFFORT=auto
ASSISTANT_LLM_API_KEY=
# Key the assistant uses to call the Cloud API (one of CLOUD_API_KEYS)
ASSISTANT_CLOUD_API_KEY=
# Keys accepted by the assistant; the dashboard sends the user's cloud API key, so reuse CLOUD_API_KEYS
ASSISTANT_API_KEYS=

# Knowledge base (RAG)
ASSISTANT_KNOWLEDGE_ENABLED=true
ASSISTANT_EMBEDDING_API_KEY=

# Langfuse tracing (optional): keys from Langfuse Cloud or a self-hosted instance
ASSISTANT_LANGFUSE_PUBLIC_KEY=
ASSISTANT_LANGFUSE_SECRET_KEY=
ASSISTANT_LANGFUSE_HOST=https://cloud.langfuse.com
