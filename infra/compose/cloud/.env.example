# Copy to .env (gitignored): env of postgres, redis and api, and the values compose interpolates.
POSTGRES_USER=edgeops
POSTGRES_PASSWORD=
POSTGRES_DB=edgeops
REDIS_PASSWORD=

CLOUD_LOG_LEVEL=INFO
CLOUD_LOG_JSON=true
# Service API keys (assistant, scripts), comma-separated. Users sign in via /api/v1/auth/login.
CLOUD_API_KEYS=
# User access tokens are RS256: the signing key is keys/jwt_private.pem (bash ../../scripts/gen-jwt-keys.sh keys)
# First account always registers as ADMIN; later sign-ups need true
CLOUD_ALLOW_REGISTRATION=false
CLOUD_NODE_HEARTBEAT_TIMEOUT_SEC=30

CLOUD_MODEL_STORE=huggingface
CLOUD_HF_TOKEN=
CLOUD_HF_ENDPOINT=https://huggingface.co
CLOUD_HF_MODEL_REPO=
