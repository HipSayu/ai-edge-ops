# Edge Agent image. Drives runtimes through the host Docker socket (docker SDK; compose mounts the socket).
FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
COPY requirements-edge.txt .
COPY packages/ packages/
RUN pip install -r requirements-edge.txt
COPY src/ src/
COPY apps/__init__.py apps/
COPY apps/edge/ apps/edge/
# Node-health early-warning model (numpy weights, ~220 KB); enabled via EDGE_HEALTH_MODEL_DIR
COPY models/node_health/ models/node_health/
EXPOSE 8081
CMD ["python", "-m", "apps.edge.main"]
