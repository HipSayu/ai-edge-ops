# Site address from $SITE_ADDRESS (set in deploy/.env.app):
#   ":80"            → plain HTTP, no cert          (bare-IP box / behind an LB)
#   "ops.example.com" → auto-HTTPS via Let's Encrypt (needs the A record + :443)
{$SITE_ADDRESS} {
	encode gzip zstd

	handle /api/* {
		reverse_proxy server:8000
	}

	# WHIP (edge publish) / WHEP (frontend view) — MediaMTX terminates the
	# WebRTC/ICE itself; Caddy only proxies the HTTP handshake.
	handle /*/whip {
		reverse_proxy mediamtx:8889
	}
	handle /*/whep {
		reverse_proxy mediamtx:8889
	}

	handle {
		reverse_proxy frontend:80
	}
}
