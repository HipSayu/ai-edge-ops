# Copy to .env and adjust. Values here are the local defaults.
# Nested groups use "__": DB__URL -> settings.db.url
ENVIRONMENT=local

CORS_ORIGINS=["http://localhost:5173"]
OFFLINE_THRESHOLD_SECONDS=90
LATENCY_SLO_MS=80

# edge transport: memory | mqtt
EDGE_TRANSPORT=memory

# --- database (settings.db) ---
DB__URL=postgresql+asyncpg://ppe:ppe@localhost:5432/ai_edge_ops
DB__POOL_SIZE=5
DB__ECHO=false

# --- mqtt (settings.mqtt, used when EDGE_TRANSPORT=mqtt) ---
MQTT__HOST=localhost
MQTT__PORT=1883
MQTT__USERNAME=
MQTT__PASSWORD=
MQTT__TLS=false
MQTT__QOS=1

# --- object storage for model artifacts (settings.s3) ---
S3__ENDPOINT_URL=http://localhost:9000
S3__ACCESS_KEY_ID=minioadmin
S3__SECRET_ACCESS_KEY=minioadmin
S3__BUCKET=artifacts

# --- redis (settings.redis) ---
REDIS__URL=redis://localhost:6379/0
