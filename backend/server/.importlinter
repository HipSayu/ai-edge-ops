[importlinter]
root_package = app

# Feature modules must not import each other's internals — only each other's
# package __init__ (public service surface) or .event (domain events).
# app.modules.iam is the shared IAM foundation and is deliberately excluded:
# any feature module may depend on it.
[importlinter:contract:feature-modules-are-independent]
name = Feature modules are independent
type = independence
modules =
    app.modules.agent
    app.modules.assistant
    app.modules.camera
    app.modules.deployment
    app.modules.model_registry
    app.modules.observability
    app.modules.streaming
    app.modules.system
ignore_imports =
    app.modules.deployment.service -> app.modules.agent
    app.modules.deployment.service -> app.modules.model_registry
    app.modules.observability.service -> app.modules.agent
    app.modules.observability.service -> app.modules.deployment
    app.modules.observability.subscribers -> app.modules.agent.event
    app.modules.observability.subscribers -> app.modules.deployment.event

[importlinter:contract:edge-adapter-is-downstream]
name = app.edge depends on modules, never the reverse
type = forbidden
source_modules =
    app.modules
forbidden_modules =
    app.edge

[importlinter:contract:core-has-no-domain-deps]
name = app.core does not import domain modules
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.modules
ignore_imports =
    # init_db() imports app.modules once at startup purely to populate
    # Base.metadata before create_all — a deliberate side-effect import.
    app.core.database -> app.modules
