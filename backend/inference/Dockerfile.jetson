# FUTURE — Jetson / DeepStream model image. NOT in the multi-arch manifest yet
# (vision_runtime/runtime/deepstream.py is still a skeleton). The default
# `Dockerfile` already covers arm64 in CPU/torch mode; use this only when the
# TensorRT/pyds pipeline is real. The .engine is built against this base's exact
# TRT/JetPack, so runtime + model + engine ship as one immutable image.
#
#   docker build -f backend/inference/Dockerfile.jetson \
#     --build-arg MODEL_VERSION=1.3.0 \
#     -t ghcr.io/hopquangdo/ai-edge-ops-model:1.3.0-jetson backend
ARG DEEPSTREAM_TAG=7.1-triton-multiarch
FROM nvcr.io/nvidia/deepstream:${DEEPSTREAM_TAG}

ARG MODEL_VERSION=0
ENV MODEL_VERSION_ID=${MODEL_VERSION} \
    RUNTIME=deepstream \
    DEVICE=cuda:0 \
    SOCKET_PATH=/run/edge/inference.sock \
    MODEL_DIR=/models

WORKDIR /srv
COPY packages/svc_core        /srv/packages/svc_core
COPY libs/edge_protocol       /srv/libs/edge_protocol
COPY inference                /srv/inference

RUN pip install --no-cache-dir -U pip \
 && pip install --no-cache-dir -e "/srv/packages/svc_core" \
 && pip install --no-cache-dir -e "/srv/libs/edge_protocol" \
 && pip install --no-cache-dir -e "/srv/inference"

# CI builds the TensorRT .engine from the exported .onnx against this base's TRT
COPY --chown=root:root models/ /models/

CMD ["vision-runtime"]
