# Copy to backend/edge_agent/.env
# Used both for `python -m edge_agent` and the docker compose `edge` profile.
ENVIRONMENT=local
LOG_LEVEL=INFO

DEVICE_ID=edge-dev-1
TRANSPORT=mqtt

HEARTBEAT_INTERVAL_S=15
RECONCILE_INTERVAL_S=30
API_HOST=0.0.0.0
API_PORT=9100
STATE_FILE=./var/edge-agent/state.json
OUTBOX_FILE=./var/edge-agent/outbox.db

# Local data stack (docker-compose.data.yml). For the VPS deploy use
# MQTT__HOST=hub.example.com  MQTT__PORT=58883  MQTT__TLS=true  (see app/nginx/README.md).
MQTT__HOST=localhost
MQTT__PORT=51883
MQTT__CLIENT_ID=edge-edge-dev-1
MQTT__USERNAME=
MQTT__PASSWORD=
MQTT__TLS=false
MQTT__QOS=1
MQTT__KEEPALIVE=30

SERVER__BASE_URL=http://localhost:8000/api/v1
SERVER__ENROLL_TOKEN=
SERVER__REQUEST_TIMEOUT_S=15

INFERENCE__WEIGHTS_DIR=./var/edge-agent/models
CAMERAS=[{"id":"bay-1","source":"0","zone":"loading-bay","enabled":true,"fps_limit":10,"loop":false}]
