# Copy to .env in this folder (backend/deploy/edge/) — docker compose reads it automatically.

# --- identity ---
# Set to the numeric device id returned by the server when you register the device
# (POST /api/v1/fleet/devices). The agent sends this as Envelope.source.
DEVICE_ID=1

# --- central broker (the EMQX from deploy/server, or your production broker) ---
MQTT_HOST=host.docker.internal
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

# --- control-plane API (HTTP fallback / enrollment) ---
SERVER_BASE_URL=http://host.docker.internal:8000/api/v1

# --- one camera ---
CAMERA_ID=bay-1
CAMERA_SOURCE=0                 # webcam index, rtsp://user:pass@host/stream, or /path/video.mp4
CAMERA_ZONE=loading-bay
