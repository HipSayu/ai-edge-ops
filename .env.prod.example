# Copy to .env on the deploy host, next to docker-compose.prod.yml.
# docker compose + Caddy read it. Never commit the filled-in version.
DOMAIN=ops.example.com

POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-with-a-random-32-character-secret
MINIO_ROOT_USER=aeo-admin
MINIO_ROOT_PASSWORD=change-me-long-random

# MQTT broker credentials. secrets/server-mqtt/ must contain ca.crt, server.crt, server.key
MQTT_USERNAME=
MQTT_PASSWORD=

# set by CI on each deploy; leave as latest for manual pulls
IMAGE_PREFIX=ghcr.io/hopquangdo/ai-edge-ops
IMAGE_TAG=latest
